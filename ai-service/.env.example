# ==============================================
# Captain Echo AI Service 환경변수 (.env.example)
# ==============================================
# 이 파일을 복사하여 .env 파일을 생성하고 실제 값을 입력하세요
# cp .env.example .env

# OpenAI API 설정 (GMS 플랫폼)
OPENAI_API_KEY=your-gms-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# Gemini API (이미지 생성용)
GEMINI_API_KEY=your-gemini-api-key-here

# AWS S3 설정 (파일 업로드용)
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=captain-echo-files

# 데이터베이스 설정
DB_HOST=postgres
DB_PORT=5432
DB_NAME=captain_echo
DB_USER=doonki
DB_PASSWORD=changeme
DATABASE_URL=postgresql://doonki:changeme@postgres:5432/captain_echo

# FastAPI 설정
API_PORT=8000
DEBUG=True

# EC2_Main Backend 연동
BACKEND_URL=http://spring-boot:8080

# Loki 로깅 (선택사항)
LOKI_URL=http://localhost:3100

# CrewAI 설정
CREW_VERBOSE=True
CREW_MEMORY=True
